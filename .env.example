# Copy to .env (never commit .env). Defaults below work for local development.
POSTGRES_DB=coursepulse
POSTGRES_USER=coursepulse
POSTGRES_PASSWORD=coursepulse

DJANGO_SECRET_KEY=dev-only-secret-change-me
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

VITE_API_BASE_URL=http://localhost:8000

# Required. Redis URL that Celery uses as its job queue. "redis" is the Compose service name.
CELERY_BROKER_URL=redis://redis:6379/0
# Redis URL where Celery stores task results.
CELERY_RESULT_BACKEND=redis://redis:6379/0
# Hard limit in seconds. The worker stops a task that runs longer.
CELERY_TASK_TIME_LIMIT=3000
# Soft limit in seconds. The task gets an error it can catch to clean up.
CELERY_TASK_SOFT_TIME_LIMIT=2700
# 1 runs tasks inline with no Redis and no worker. Keep 0 in Docker.
CELERY_TASK_ALWAYS_EAGER=0
# How many jobs one worker runs at the same time.
CELERY_WORKER_CONCURRENCY=2

# The OpenAI key is needed for transcription and question generation. Leave it empty in this file. Put your own key only in .env.
OPENAI_API_KEY=
# A lecture is rejected when its estimated transcription cost is above this many US dollars.
TRANSCRIPTION_MAX_COST_USD=2.00
# A lecture is rejected when its audio is longer than this many seconds (14400 is 4 hours).
TRANSCRIPTION_MAX_SECONDS=14400
# The OpenAI model for both question stages: it finds the concepts and writes the questions.
QUESTION_MODEL=gpt-6-luna
# Question generation stops before a call that would push one lecture over this many US dollars.
QUESTION_MAX_COST_USD=0.25
# The question target is the transcript word count divided by this number.
QUESTION_WORDS_PER_QUESTION=300
# The lowest question target for one lecture.
QUESTION_MIN_COUNT=20
# The highest question target for one lecture.
QUESTION_MAX_COUNT=40
# The job fails when fewer than this many usable questions remain.
QUESTION_FLOOR_COUNT=10
# Seconds to wait for one OpenAI question request. Keep it under 450 seconds, so two tries
# of one call stay inside the 15-minute stuck-job cutoff.
QUESTION_TIMEOUT_SECONDS=180
# Largest upload in bytes (2147483648 is 2 GB).
LECTURE_UPLOAD_MAX_BYTES=2147483648
