# Copy to .env (never commit .env). Defaults below work for local development.
POSTGRES_DB=coursepulse
POSTGRES_USER=coursepulse
POSTGRES_PASSWORD=coursepulse

DJANGO_SECRET_KEY=dev-only-secret-change-me
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

VITE_API_BASE_URL=http://localhost:8000

# Redis URL that Celery uses as its job queue. "redis" is the Compose service name.
CELERY_BROKER_URL=redis://redis:6379/0
# Redis URL where Celery stores task results.
CELERY_RESULT_BACKEND=redis://redis:6379/0
# Hard limit in seconds. The worker stops a task that runs longer.
CELERY_TASK_TIME_LIMIT=1800
# Soft limit in seconds. The task gets an error it can catch to clean up.
CELERY_TASK_SOFT_TIME_LIMIT=1500
# 1 runs tasks inline with no Redis and no worker. Keep 0 in Docker.
CELERY_TASK_ALWAYS_EAGER=0

# Needed later for transcription and question generation (SCRUM-70, SCRUM-71). Leave empty for now.
OPENAI_API_KEY=
